# 1) Buang kolom nomor urut "Unnamed: 0" kalau ada (kolom ini tidak berguna untuk prediksi)
if "Unnamed: 0" in df.columns:
    df = df.drop(columns=["Unnamed: 0"])

# 2) Hapus baris dobel dan baris kosong (jaga-jaga, walau di data ini tidak ada)
df = df.drop_duplicates().dropna()

# 3) Pisahkan "bahan" (X) dan "jawaban" (y)
X = df[["YearsExperience"]]   # X = fitur  -> pakai kurung DOUBLE [[ ]] supaya bentuknya tabel
y = df["Salary"]              # y = target -> pakai kurung biasa [ ] cukup

print("Bentuk X:", X.shape)
print("Bentuk y:", y.shape)

# Bagi data: 80% untuk BELAJAR (train) dan 20% untuk UJIAN (test)
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.2,       # 20% data disimpan untuk ujian
    random_state=42      # angka acak dikunci supaya hasil selalu sama setiap dijalankan
)

print("Data belajar (train):", X_train.shape[0], "baris")
print("Data ujian   (test) :", X_test.shape[0], "baris")



model = LinearRegression()          # 1) Buat model kosong (belum pintar)
model.fit(X_train, y_train)         # 2) Latih model dengan data belajar -> komputer mencari garis terbaik

# Lihat hasil "belajar"-nya
slope = model.coef_[0]              # kenaikan gaji per 1 tahun pengalaman
intercept = model.intercept_        # gaji awal ketika pengalaman 0 tahun

print(f"Slope (m)     : {slope:,.2f}")
print(f"Intercept (c) : {intercept:,.2f}")
print()
print(f"Rumus model: Gaji = {slope:,.2f} x Pengalaman + {intercept:,.2f}")


y_pred = model.predict(X_test)      # model menebak gaji untuk data ujian

